<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- ============================================================
       图标几何：24×24 网格，统一线性/实心极简风格，单色（无 emoji）
       ============================================================ -->

  <!-- 闪电：HUD 主图标，由上下两个平行四边形 fill 拼成（参考原视频）
     底边比顶边宽（梯形），让电标看着更宽更稳 -->
  <StreamGeometry x:Key="Geo.Bolt">M13 2 L4 13 L12 13 L18 2 Z M13 11 L20 11 L13 22 L4 22 Z</StreamGeometry>

  <!-- 闪电：黄绿徽章中心的小号双平行四边形 -->
  <StreamGeometry x:Key="Geo.Bolt.Small">M12 3 L5 12 L10 12 L16 3 Z M13 12 L19 12 L12 21 L6 21 Z</StreamGeometry>

  <!-- 插头 / 交流：拔电或未接电源时的备用图标 -->
  <StreamGeometry x:Key="Geo.Plug">M12 2 C9.24 2 7 4.24 7 7 V10 H9 V7 C9 5.34 10.34 4 12 4 C13.66 4 15 5.34 15 7 V10 H17 V7 C17 4.24 14.76 2 12 2 Z M8 12 H16 V15 C16 17.21 14.21 19 12 19 C9.79 19 8 17.21 8 15 V12 Z M10 19.5 H14 V22 H10 V19.5 Z</StreamGeometry>

  <!-- ============================================================
       音乐岛图标：取自 Google Material Icons（Apache-2.0），同为 24×24 网格。
       只保留字形 path（剔除原文件里 fill="none" 的透明边框矩形）。
       摆放统一：方形 Canvas(24×24) → 方形 Viewbox（按网格归一化、必然居中）。
       ============================================================ -->
  <StreamGeometry x:Key="Icon.PlayArrow">M8 5v14l11-7z</StreamGeometry>
  <StreamGeometry x:Key="Icon.Pause">M6 19h4V5H6v14zm8-14v14h4V5h-4z</StreamGeometry>
  <StreamGeometry x:Key="Icon.SkipPrevious">M6 6h2v12H6zm3.5 6l8.5 6V6z</StreamGeometry>
  <StreamGeometry x:Key="Icon.SkipNext">M6 18l8.5-6L6 6v12zM16 6v12h2V6h-2z</StreamGeometry>
  <StreamGeometry x:Key="Icon.ChevronDown">M7.41 8.59L12 13.17l4.59-4.58L18 10l-6 6-6-6 1.41-1.41z</StreamGeometry>
  <StreamGeometry x:Key="Icon.MusicNote">M12 3v10.55c-.59-.34-1.27-.55-2-.55-2.21 0-4 1.79-4 4s1.79 4 4 4 4-1.79 4-4V7h4V3h-6z</StreamGeometry>

  <!-- ============================================================
       设置抽屉图标：同取 Google Material Icons（Apache-2.0），24×24 网格、纯填充。
       ============================================================ -->
  <!-- 收起（chevron up）：抽屉底部「收起」键 -->
  <StreamGeometry x:Key="Icon.ChevronUp">M7.41 15.41L12 10.83l4.59 4.58L18 14l-6-6-6 6z</StreamGeometry>
  <!-- 保存（save）：抽屉底部「保存」键，软盘字形 -->
  <StreamGeometry x:Key="Icon.Save">M17 3H5c-1.11 0-2 .9-2 2v14c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2V7l-4-4zm-5 16c-1.66 0-3-1.34-3-3s1.34-3 3-3 3 1.34 3 3-1.34 3-3 3zm3-10H5V5h10v4z</StreamGeometry>
  <!-- 设置（settings）：抽屉头部齿轮 -->
  <StreamGeometry x:Key="Icon.Settings">M19.5 12c0-.23-.01-.45-.03-.68l1.86-1.41c.4-.3.51-.86.26-1.3l-1.87-3.23a.987.987 0 0 0-1.25-.42l-2.15.91c-.37-.26-.76-.49-1.17-.68l-.29-2.31c-.06-.5-.49-.88-.99-.88h-3.73c-.51 0-.94.38-1 .88l-.29 2.31c-.41.19-.8.42-1.17.68l-2.15-.91c-.46-.2-1-.02-1.25.42L2.41 8.62c-.25.44-.14.99.26 1.3l1.86 1.41a7.3 7.3 0 0 0 0 1.35l-1.86 1.41c-.4.3-.51.86-.26 1.3l1.87 3.23c.25.44.79.62 1.25.42l2.15-.91c.37.26.76.49 1.17.68l.29 2.31c.06.5.49.88.99.88h3.73c.5 0 .93-.38.99-.88l.29-2.31c.41-.19.8-.42 1.17-.68l2.15.91c.46.2 1 .02 1.25-.42l1.87-3.23c.25-.44.14-.99-.26-1.3l-1.86-1.41c.03-.23.04-.45.04-.68m-7.46 3.5c-1.93 0-3.5-1.57-3.5-3.5s1.57-3.5 3.5-3.5s3.5 1.57 3.5 3.5s-1.57 3.5-3.5 3.5</StreamGeometry>

</ResourceDictionary>
