<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows10.0.17763.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
    <RootNamespace>EndfieldCharge.Tests</RootNamespace>
    <!-- 与宿主保持同一平台，便于直接引用宿主工程里的纯逻辑类型 -->
    <PlatformTarget>x64</PlatformTarget>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <!-- 纯逻辑（IslandStateMachine / IslandVisualState 等）目前在宿主工程内，按现状直接引用；
       将来若下沉到契约程序集，这里改成引用契约即可。 -->
  <ItemGroup>
    <ProjectReference Include="..\..\EndfieldCharge.csproj" />
  </ItemGroup>

  <!-- 音乐插件里的纯逻辑（LRC 解析、以及后续的歌词匹配 / 频谱分带）同样按现状直接引用：
       插件与测试工程的 TFM 一致（net8.0-windows10.0.17763.0），无需额外平台调整。 -->
  <ItemGroup>
    <ProjectReference Include="..\..\plugins\EndfieldCharge.Plugin.Music\EndfieldCharge.Plugin.Music.csproj" />
  </ItemGroup>

</Project>
