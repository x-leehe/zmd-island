<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="160"
        x:Class="EndfieldCharge.Views.HudWindow"
        Width="1200" Height="160"
        Title="EndfieldIsland"

        SystemDecorations="None"
        Background="Transparent"

        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        CanResize="False"
        Focusable="False"
        WindowStartupLocation="Manual">

  <!-- 资源保留给 FpsText（Hud.FontFamilyNumeric）；岛皮肤自己的资源在 BatteryIslandView 内 -->
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://EndfieldCharge.Contracts.Avalonia/Styles/Geometries.axaml"/>
        <ResourceInclude Source="avares://EndfieldIsland/Styles/HudTheme.axaml"/>
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Window.Resources>

  <!-- 窗口只保留 chrome：ContentControl 承载插件皮肤（电池元插件 BatteryIslandView），
       其余为 FPS 调试计数器。位置与原 Root 底缘一致：
       窗口 160 高、Root 100 高居中 → Root 底缘 y=130，窗口底对齐需下移 30+2=32 -->
  <Grid x:Name="RootGrid" Width="1200" Height="160">
    <ContentControl x:Name="IslandHost" Width="1200" Height="160"/>
    <TextBlock x:Name="FpsText"
               HorizontalAlignment="Right" VerticalAlignment="Bottom"
               FontFamily="{DynamicResource Hud.FontFamilyNumeric}"
               FontSize="9" FontWeight="Medium"
               Foreground="#C6CA4C" Opacity="0.6"
               Margin="0,0,4,32"
               IsVisible="False"
               Text="-- FPS"/>
  </Grid>
</Window>
