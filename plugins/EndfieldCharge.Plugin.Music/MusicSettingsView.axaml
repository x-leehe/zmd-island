<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="EndfieldCharge.Host.Plugins.Music.MusicSettingsView"
             FontFamily="HarmonyOS Sans SC, HarmonyOS Sans, Inter, Microsoft YaHei UI, sans-serif">
  <!-- 音乐插件设置面板：宿主「插件」页承载。排版与宿主设置页共用同一套全局 class
       （section-title / section-bar / row-label / row-desc / row-value），改动即保存并立即生效。 -->
  <StackPanel Spacing="24">

    <!-- ================= 音乐岛 ================= -->
    <StackPanel>
      <TextBlock x:Name="SectionText" Classes="section-title" Text="音乐岛"/>
      <Border Classes="section-bar"/>
      <StackPanel Spacing="12">

        <StackPanel>
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock x:Name="LabelExpandedTimeout" Classes="row-label"/>
            <NumericUpDown x:Name="ExpandedTimeoutStepper" Grid.Column="1" Width="140" Height="36" Minimum="3" Maximum="30" Increment="0.5" ShowButtonSpinner="True" VerticalAlignment="Center" Margin="16,0,0,0"/>
          </Grid>
          <Slider x:Name="ExpandedTimeoutSlider" Margin="0,12,0,0" Minimum="3" Maximum="30"
                  TickFrequency="0.5" Value="6" IsSnapToTickEnabled="True"/>
        </StackPanel>

        <Grid ColumnDefinitions="*,Auto">
          <TextBlock x:Name="LabelShowTitle" Classes="row-label"/>
          <ToggleSwitch x:Name="ShowTitleSwitch" Grid.Column="1" Margin="16,0,0,0"
                        VerticalAlignment="Center" OnContent="" OffContent=""/>
        </Grid>

        <Grid ColumnDefinitions="*,Auto">
          <TextBlock x:Name="LabelVisualizer" Classes="row-label"/>
          <ToggleSwitch x:Name="VisualizerSwitch" Grid.Column="1" Margin="16,0,0,0"
                        VerticalAlignment="Center" OnContent="" OffContent=""/>
        </Grid>

        <StackPanel>
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock x:Name="LabelVisualizerIntensity" Classes="row-label"/>
            <NumericUpDown x:Name="VisualizerIntensityStepper" Grid.Column="1" Width="140" Height="36" Minimum="0.5" Maximum="3" Increment="0.1" ShowButtonSpinner="True" VerticalAlignment="Center" Margin="16,0,0,0"/>
          </Grid>
          <Slider x:Name="VisualizerIntensitySlider" Margin="0,12,0,0" Minimum="0.5" Maximum="3"
                  TickFrequency="0.1" Value="1.5" IsSnapToTickEnabled="True"/>
        </StackPanel>

        <StackPanel>
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock x:Name="LabelVisualizerBars" Classes="row-label"/>
            <NumericUpDown x:Name="VisualizerBarsStepper" Grid.Column="1" Width="140" Height="36" Minimum="24" Maximum="96" Increment="4" ShowButtonSpinner="True" VerticalAlignment="Center" Margin="16,0,0,0"/>
          </Grid>
          <Slider x:Name="VisualizerBarsSlider" Margin="0,12,0,0" Minimum="24" Maximum="96"
                  TickFrequency="4" Value="64" IsSnapToTickEnabled="True"/>
        </StackPanel>

        <Grid ColumnDefinitions="*,Auto">
          <TextBlock x:Name="LabelLyricSource" Classes="row-label"/>
          <ComboBox x:Name="LyricSourceCombo" Grid.Column="1" Width="240" Height="36"
                    Margin="16,0,0,0" VerticalAlignment="Center"/>
        </Grid>

        <!-- 歌词磁盘缓存：目录与手写的本地歌词共用，清空只删缓存文件 -->
        <StackPanel>
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock x:Name="LabelLyricsCacheLimit" Classes="row-label"/>
            <NumericUpDown x:Name="LyricsCacheLimitStepper" Grid.Column="1" Width="140" Height="36" Minimum="5" Maximum="200" Increment="5" ShowButtonSpinner="True" VerticalAlignment="Center" Margin="16,0,0,0"/>
          </Grid>
          <TextBlock x:Name="DescLyricsCacheLimit" Classes="row-desc" Margin="0,6,0,0"/>
          <Slider x:Name="LyricsCacheLimitSlider" Margin="0,12,0,0" Minimum="5" Maximum="200"
                  TickFrequency="5" Value="20" IsSnapToTickEnabled="True"/>
          <Grid ColumnDefinitions="*,Auto" Margin="0,6,0,0">
            <TextBlock x:Name="LyricsCacheUsageText" Classes="row-desc" VerticalAlignment="Center"/>
            <Button x:Name="LyricsCacheClearButton" Grid.Column="1" Margin="16,0,0,0" FontSize="14" Height="36"
                    HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
          </Grid>
          <TextBlock x:Name="LyricsCacheStatusText" Classes="row-desc" Foreground="#C6CA4C" Opacity="0"/>
        </StackPanel>
      </StackPanel>
    </StackPanel>

    <!-- ================= 音乐来源白名单 ================= -->
    <StackPanel>
      <TextBlock x:Name="LabelMusicSourceWhitelist" Classes="section-title"/>
      <Border Classes="section-bar"/>
      <TextBlock x:Name="HintMusicSourceWhitelist" Classes="row-desc" Margin="0,12,0,0"/>

      <TextBlock x:Name="WhitelistAllowedLabel" Classes="row-desc" Margin="0,12,0,0"/>
      <StackPanel x:Name="WhitelistRows" Spacing="6" Margin="0,6,0,0"/>
      <TextBlock x:Name="WhitelistEmptyLabel" Classes="row-desc" Margin="0,6,0,0"/>

      <Grid ColumnDefinitions="*,Auto" Margin="0,12,0,0">
        <TextBox x:Name="WhitelistInput" FontSize="14" Height="36"/>
        <Button x:Name="WhitelistAddButton" Grid.Column="1" Margin="8,0,0,0" FontSize="14" Height="36"
                HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
      </Grid>

      <TextBlock x:Name="WhitelistKnownLabel" Classes="row-desc" Margin="0,12,0,0"/>
      <StackPanel x:Name="WhitelistKnownRows" Spacing="6" Margin="0,6,0,0"/>
      <TextBlock x:Name="WhitelistKnownEmptyLabel" Classes="row-desc" Margin="0,6,0,0"/>
    </StackPanel>

    <TextBlock x:Name="SavedText" Classes="row-desc" Foreground="#C6CA4C" Opacity="0"/>
  </StackPanel>
</UserControl>
