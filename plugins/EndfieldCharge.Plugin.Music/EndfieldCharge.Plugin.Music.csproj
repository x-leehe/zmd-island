<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- 外部插件 DLL：产出 EndfieldCharge.Plugin.Music.dll，随宿主丢进 plugins/ 即被加载。
         只引用两个契约程序集 + Avalonia（框架依赖），不引用主程序。 -->
    <TargetFramework>net8.0-windows10.0.17763.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>EndfieldCharge.Plugin.Music</AssemblyName>
    <RootNamespace>EndfieldCharge.Plugin.Music</RootNamespace>
    <PlatformTarget>x64</PlatformTarget>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.2.1" />
    <ProjectReference Include="..\..\src\EndfieldCharge.Contracts\EndfieldCharge.Contracts.csproj">
      <Private>false</Private>
    </ProjectReference>
    <ProjectReference Include="..\..\src\EndfieldCharge.Contracts.Avalonia\EndfieldCharge.Contracts.Avalonia.csproj">
      <Private>false</Private>
    </ProjectReference>
  </ItemGroup>

</Project>
