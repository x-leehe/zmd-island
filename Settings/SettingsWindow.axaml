<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DesignWidth="580" d:DesignHeight="696"
        x:Class="EndfieldCharge.Settings.SettingsWindow"
        Title="EndfieldCharge · 设置"
        Width="580"
        SystemDecorations="None"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        CanResize="False"
        WindowStartupLocation="Manual"
        Foreground="#E8E8E8"
        FontFamily="HarmonyOS Sans SC, HarmonyOS Sans, Inter, Microsoft YaHei UI, sans-serif">

  <!-- 设置抽屉：整窗 = 面板本身（岛体由 HudWindow 独立显示），
       锚定在岛下缘、圆角无边框，视觉与几何取自 docs/designs/settings-all.json：
       左右内边距 28、内容右缘 532、行节奏 12、分组标题 fs18 + 36×8 强调条。 -->
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://EndfieldCharge.Contracts.Avalonia/Styles/Geometries.axaml"/>
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Window.Resources>

  <Window.Styles>
    <!-- 分段页签：容器 5% 白，活动段 14% 白 + 高亮文字 -->
    <Style Selector="Border.segment">
      <Setter Property="CornerRadius" Value="6"/>
      <Setter Property="Margin" Value="1,0"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="Border.segment TextBlock">
      <Setter Property="FontSize" Value="18"/>
      <Setter Property="Foreground" Value="#8C8C8C"/>
      <Setter Property="HorizontalAlignment" Value="Center"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>
    <Style Selector="Border.segment:pointerover">
      <Setter Property="Background" Value="#12FFFFFF"/>
    </Style>
    <Style Selector="Border.segment:pointerover TextBlock">
      <Setter Property="Foreground" Value="#E8E8E8"/>
    </Style>
    <Style Selector="Border.segment.active">
      <Setter Property="Background" Value="#24FFFFFF"/>
    </Style>
    <Style Selector="Border.segment.active TextBlock">
      <Setter Property="Foreground" Value="#F0F0F0"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <!-- 底部圆形动作键（保存 = 强调实心；收起 = 8% 白圆底） -->
    <Style Selector="Button.round-action">
      <Setter Property="Width" Value="40"/>
      <Setter Property="Height" Value="40"/>
      <Setter Property="CornerRadius" Value="20"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="Button.save-action">
      <Setter Property="Background" Value="#C6CA4C"/>
    </Style>
    <Style Selector="Button.save-action:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#D3D75E"/>
    </Style>
    <Style Selector="Button.save-action:pressed /template/ ContentPresenter">
      <Setter Property="Background" Value="#B3B840"/>
    </Style>
    <Style Selector="Button.collapse-action">
      <Setter Property="Background" Value="#14FFFFFF"/>
    </Style>
    <Style Selector="Button.collapse-action:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#24FFFFFF"/>
    </Style>
    <Style Selector="Button.collapse-action:pressed /template/ ContentPresenter">
      <Setter Property="Background" Value="#30FFFFFF"/>
    </Style>

    <!-- 强调主按钮（动画预览「播放」等） -->
    <Style Selector="Button.accent:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#D3D75E"/>
    </Style>
    <Style Selector="Button.accent:pressed /template/ ContentPresenter">
      <Setter Property="Background" Value="#B3B840"/>
    </Style>

    <!-- 内容滚动条：贴右缘的细条（设计：552..560） -->
    <Style Selector="ScrollViewer.slim ScrollBar:vertical">
      <Setter Property="Width" Value="8"/>
      <Setter Property="MinWidth" Value="8"/>
      <Setter Property="Margin" Value="0,4,2,4"/>
      <Setter Property="Background" Value="Transparent"/>
    </Style>
    <Style Selector="ScrollViewer.slim ScrollBar:vertical /template/ Thumb">
      <Setter Property="Opacity" Value="0.35"/>
    </Style>
  </Window.Styles>

  <!-- ScaleRoot：只做一次「设计尺寸 × 全局缩放」的渲染缩放；窗口尺寸同比例，二者不叠加，
       否则内容会被缩放两次（既不等于岛宽，也不同步）。ContentRoot 另留 ShadowPad 透明边距给阴影。 -->
  <Grid x:Name="ScaleRoot" HorizontalAlignment="Left" VerticalAlignment="Top" RenderTransformOrigin="0,0">
    <Grid.RenderTransform>
      <ScaleTransform/>
    </Grid.RenderTransform>
    <Border x:Name="ContentRoot"
            Margin="10"
            Background="#312F30"
            CornerRadius="30"
            BoxShadow="0 1 6 #40000000">
      <Border.RenderTransform>
        <TranslateTransform X="0" Y="-12"/>
      </Border.RenderTransform>

    <Grid RowDefinitions="Auto,Auto,*,Auto">

      <!-- ================= 头部：设置图标 40×40 + 标题 fs20 + 右侧字标 fs16 ================= -->
      <Grid Grid.Row="0" Height="40" Margin="28,12,28,0" ColumnDefinitions="Auto,Auto,*,Auto">
        <Border Width="40" Height="40" VerticalAlignment="Center">
          <Path Width="28" Height="28" Stretch="Uniform"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                Data="{DynamicResource Icon.Settings}" Fill="#C6CA4C"/>
        </Border>
        <TextBlock x:Name="WinTitle" Grid.Column="1" Margin="8,0,12,0"
                   FontSize="20" FontWeight="SemiBold" Foreground="#F0F0F0"
                   VerticalAlignment="Center"/>
        <TextBlock x:Name="WordmarkText" Grid.Column="3"
                   FontSize="16" Foreground="#888888" VerticalAlignment="Center"/>
      </Grid>

      <!-- ================= 分段页签：504×40，六等分 ================= -->
      <Border Grid.Row="1" Height="40" Margin="28,6,28,0"
              CornerRadius="9" Background="#0DFFFFFF" Padding="3">
        <Grid ColumnDefinitions="*,*,*,*,*,*">
          <Border x:Name="TabGeneralBtn" Grid.Column="0" Classes="segment">
            <TextBlock x:Name="TabGeneralText"/>
          </Border>
          <Border x:Name="TabAnimationBtn" Grid.Column="1" Classes="segment">
            <TextBlock x:Name="TabAnimationText"/>
          </Border>
          <Border x:Name="TabNotificationsBtn" Grid.Column="2" Classes="segment">
            <TextBlock x:Name="TabNotificationsText"/>
          </Border>
          <Border x:Name="TabPluginsBtn" Grid.Column="3" Classes="segment">
            <TextBlock x:Name="TabPluginsText"/>
          </Border>
          <Border x:Name="TabDeveloperBtn" Grid.Column="4" Classes="segment">
            <TextBlock x:Name="TabDeveloperText"/>
          </Border>
          <Border x:Name="TabAboutBtn" Grid.Column="5" Classes="segment">
            <TextBlock x:Name="TabAboutText"/>
          </Border>
        </Grid>
      </Border>

      <!-- ================= 内容：可滚动（超出高度由细滚动条承担） ================= -->
      <ScrollViewer x:Name="ContentScroll" Grid.Row="2" Classes="slim"
                    VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="28,24,20,16" Spacing="24">

          <!-- ========== 通用 ========== -->
          <StackPanel x:Name="GeneralPanel" Spacing="24">

            <!-- 显示 -->
            <StackPanel>
              <TextBlock x:Name="SectionDisplayText" Classes="section-title"/>
              <Border Classes="section-bar"/>
              <StackPanel Spacing="12">
                <StackPanel>
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock x:Name="LabelScale" Classes="row-label"/>
                    <NumericUpDown x:Name="ScaleStepper" Grid.Column="1" Width="140" Height="36" Minimum="0.4" Maximum="1.2" Increment="0.05" ShowButtonSpinner="True" VerticalAlignment="Center" Margin="16,0,0,0"/>
                  </Grid>
                  <Slider x:Name="ScaleSlider" Margin="0,12,0,0"
                          Minimum="0.4" Maximum="1.2" TickFrequency="0.05"
                          Value="0.8" IsSnapToTickEnabled="False"/>
                </StackPanel>

                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                  <TextBlock x:Name="LabelTopmost" Classes="row-label"/>
                  <ToggleSwitch x:Name="WindowTopmostSwitch" Grid.Column="1" Margin="16,0,0,0"
                                VerticalAlignment="Center" OnContent="" OffContent=""/>
                  <TextBlock x:Name="DescTopmostText" Grid.Row="1" Classes="row-desc" Margin="0,2,16,0"/>
                </Grid>

                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                  <TextBlock x:Name="LabelWheelSwitch" Classes="row-label"/>
                  <ComboBox x:Name="WheelSwitchCombo" Grid.Column="1" Width="140" Height="36"
                            Margin="16,0,0,0" VerticalAlignment="Center"/>
                  <TextBlock x:Name="DescWheelSwitchText" Grid.Row="1" Classes="row-desc" Margin="0,2,16,0"/>
                </Grid>
              </StackPanel>
            </StackPanel>

            <!-- 位置与语言 -->
            <StackPanel>
              <TextBlock x:Name="SectionPositionText" Classes="section-title"/>
              <Border Classes="section-bar"/>
              <StackPanel Spacing="12">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock x:Name="LabelPosition" Classes="row-label"/>
                  <ComboBox x:Name="PositionCombo" Grid.Column="1" Width="140" Height="36"
                            Margin="16,0,0,0" VerticalAlignment="Center"/>
                </Grid>
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock x:Name="LabelMonitor" Classes="row-label"/>
                  <ComboBox x:Name="MonitorCombo" Grid.Column="1" Width="140" Height="36"
                            Margin="16,0,0,0" VerticalAlignment="Center"/>
                </Grid>
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock x:Name="LabelLanguage" Classes="row-label"/>
                  <ComboBox x:Name="LanguageCombo" Grid.Column="1" Width="140" Height="36"
                            Margin="16,0,0,0" VerticalAlignment="Center"/>
                </Grid>
              </StackPanel>
            </StackPanel>

            <!-- 启动 -->
            <StackPanel>
              <TextBlock x:Name="SectionStartupText" Classes="section-title"/>
              <Border Classes="section-bar"/>
              <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                <TextBlock x:Name="LabelAutoStart" Classes="row-label"/>
                <ToggleSwitch x:Name="AutoStartSwitch" Grid.Column="1" Margin="16,0,0,0"
                              VerticalAlignment="Center" OnContent="" OffContent=""/>
                <TextBlock x:Name="DescAutoStartText" Grid.Row="1" Classes="row-desc" Margin="0,2,16,0"/>
              </Grid>
            </StackPanel>
          </StackPanel>

          <!-- ========== 动画 ========== -->
          <StackPanel x:Name="AnimationPanel" IsVisible="False" Spacing="24">

            <!-- 动画参数 -->
            <StackPanel>
              <TextBlock x:Name="SectionAnimParams" Classes="section-title"/>
              <Border Classes="section-bar"/>
              <StackPanel Spacing="12">
                <StackPanel>
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock x:Name="LabelWaitingTimeout" Classes="row-label"/>
                    <NumericUpDown x:Name="WaitingTimeoutStepper" Grid.Column="1" Width="140" Height="36" Minimum="1" Maximum="30" Increment="0.5" ShowButtonSpinner="True" VerticalAlignment="Center" Margin="16,0,0,0"/>
                  </Grid>
                  <Slider x:Name="WaitingTimeoutSlider" Margin="0,12,0,0"
                          Minimum="1" Maximum="30" TickFrequency="0.5"
                          Value="4" IsSnapToTickEnabled="True"/>
                </StackPanel>

                <StackPanel>
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock x:Name="LabelContractedTimeout" Classes="row-label"/>
                    <NumericUpDown x:Name="ContractedTimeoutStepper" Grid.Column="1" Width="140" Height="36" Minimum="1" Maximum="30" Increment="0.5" ShowButtonSpinner="True" VerticalAlignment="Center" Margin="16,0,0,0"/>
                  </Grid>
                  <Slider x:Name="ContractedTimeoutSlider" Margin="0,12,0,0"
                          Minimum="1" Maximum="30" TickFrequency="0.5"
                          Value="4" IsSnapToTickEnabled="True"/>
                </StackPanel>

                <StackPanel>
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock x:Name="LabelBounce" Classes="row-label"/>
                    <NumericUpDown x:Name="BounceStepper" Grid.Column="1" Width="140" Height="36" Minimum="0" Maximum="0.5" Increment="0.025" ShowButtonSpinner="True" VerticalAlignment="Center" Margin="16,0,0,0"/>
                  </Grid>
                  <Slider x:Name="BounceSlider" Margin="0,12,0,0"
                          Minimum="0" Maximum="0.5" TickFrequency="0.025"
                          Value="0.275" IsSnapToTickEnabled="False"/>
                </StackPanel>

                <StackPanel>
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock x:Name="LabelRippleIntensity" Classes="row-label"/>
                    <NumericUpDown x:Name="RippleIntensityStepper" Grid.Column="1" Width="140" Height="36" Minimum="0" Maximum="2" Increment="0.05" ShowButtonSpinner="True" VerticalAlignment="Center" Margin="16,0,0,0"/>
                  </Grid>
                  <Slider x:Name="RippleIntensitySlider" Margin="0,12,0,0"
                          Minimum="0" Maximum="2" TickFrequency="0.05"
                          Value="1" IsSnapToTickEnabled="False"/>
                </StackPanel>

                <StackPanel>
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock x:Name="LabelRippleSpread" Classes="row-label"/>
                    <NumericUpDown x:Name="RippleSpreadStepper" Grid.Column="1" Width="140" Height="36" Minimum="0.5" Maximum="1.5" Increment="0.05" ShowButtonSpinner="True" VerticalAlignment="Center" Margin="16,0,0,0"/>
                  </Grid>
                  <Slider x:Name="RippleSpreadSlider" Margin="0,12,0,0"
                          Minimum="0.5" Maximum="1.5" TickFrequency="0.05"
                          Value="1" IsSnapToTickEnabled="False"/>
                </StackPanel>
              </StackPanel>
            </StackPanel>

            <!-- 预览 -->
            <StackPanel>
              <TextBlock x:Name="SectionPreview" Classes="section-title"/>
              <Border Classes="section-bar"/>
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock x:Name="LabelPlayMode" Classes="row-label"/>
                <ComboBox x:Name="PreviewModeCombo" Grid.Column="1" Width="140" Height="36"
                          Margin="16,0,0,0" VerticalAlignment="Center" SelectedIndex="0"/>
              </Grid>
              <Grid ColumnDefinitions="*,Auto" Margin="0,12,0,0">
                <Button x:Name="PreviewPlayBtn" Grid.Column="1" Classes="accent"
                        Width="140" Height="36"
                        Background="#C6CA4C" Foreground="#1A1A1C"
                        FontWeight="SemiBold" FontSize="14"
                        CornerRadius="8" Cursor="Hand"
                        HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
              </Grid>
            </StackPanel>
          </StackPanel>

          <!-- ========== 通知 ========== -->
          <StackPanel x:Name="NotificationsPanel" IsVisible="False" Spacing="24">
            <StackPanel>
              <TextBlock x:Name="SectionAlertSettingsText" Classes="section-title"/>
              <Border Classes="section-bar"/>
              <StackPanel Spacing="12">
                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                  <TextBlock x:Name="LabelPowerSaverNotify" Classes="row-label"/>
                  <ToggleSwitch x:Name="PowerSaverSwitch" Grid.Column="1" Margin="16,0,0,0"
                                VerticalAlignment="Center" IsChecked="True" OnContent="" OffContent=""/>
                  <TextBlock x:Name="PowerSaverNotifyDesc" Grid.Row="1" Classes="row-desc" Margin="0,2,16,0"/>
                </Grid>

                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                  <TextBlock x:Name="LabelLowBatteryEnable" Classes="row-label"/>
                  <ToggleSwitch x:Name="LowBatterySwitch" Grid.Column="1" Margin="16,0,0,0"
                                VerticalAlignment="Center" IsChecked="True" OnContent="" OffContent=""/>
                  <TextBlock x:Name="DescLowBatteryAlertText" Grid.Row="1" Classes="row-desc" Margin="0,2,16,0"/>
                </Grid>

                <StackPanel>
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock x:Name="LabelLowBattery" Classes="row-label"/>
                    <NumericUpDown x:Name="LowBatteryStepper" Grid.Column="1" Width="140" Height="36" Minimum="5" Maximum="40" Increment="5" ShowButtonSpinner="True" VerticalAlignment="Center" Margin="16,0,0,0"/>
                  </Grid>
                  <Slider x:Name="LowBatterySlider" Margin="0,12,0,0"
                          Minimum="5" Maximum="40" TickFrequency="5"
                          Value="20" IsSnapToTickEnabled="True"/>
                </StackPanel>

                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                  <TextBlock x:Name="LabelFullChargeEnable" Classes="row-label"/>
                  <ToggleSwitch x:Name="FullChargeSwitch" Grid.Column="1" Margin="16,0,0,0"
                                VerticalAlignment="Center" IsChecked="True" OnContent="" OffContent=""/>
                  <TextBlock x:Name="DescFullChargeAlertText" Grid.Row="1" Classes="row-desc" Margin="0,2,16,0"/>
                </Grid>
              </StackPanel>
            </StackPanel>
          </StackPanel>

          <!-- ========== 插件（面板由插件自绘） ========== -->
          <StackPanel x:Name="PluginsPanel" IsVisible="False" Spacing="24">
            <StackPanel>
              <TextBlock x:Name="SectionPluginsText" Classes="section-title"/>
              <Border Classes="section-bar"/>
              <TextBlock x:Name="NoPluginSettingsText" Classes="row-desc" Margin="0,12,0,0" IsVisible="False"/>
              <StackPanel x:Name="PluginPages" Spacing="16" Margin="0,12,0,0"/>
            </StackPanel>
          </StackPanel>

          <!-- ========== 开发者（占位页，无功能控件） ========== -->
          <StackPanel x:Name="DeveloperPanel" IsVisible="False" Spacing="24">
            <StackPanel>
              <TextBlock x:Name="SectionDeveloperText" Classes="section-title"/>
              <Border Classes="section-bar"/>
              <TextBlock x:Name="DeveloperStubText" Classes="row-desc" Margin="0,12,0,0"/>
            </StackPanel>
          </StackPanel>

          <!-- ========== 关于 ========== -->
          <StackPanel x:Name="AboutPanel" IsVisible="False" Spacing="24">
            <StackPanel>
              <TextBlock x:Name="SectionAboutText" Classes="section-title"/>
              <Border Classes="section-bar"/>
              <StackPanel Spacing="16" Margin="0,12,0,0">
                <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center">
                  <Border Width="48" Height="48" CornerRadius="12" Background="#2A2A2D">
                    <Image Width="28" Height="28" Source="avares://EndfieldCharge/Assets/tray_bolt.png"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                  </Border>
                  <StackPanel Spacing="2" VerticalAlignment="Center">
                    <TextBlock Text="EndfieldCharge" FontSize="18" FontWeight="Bold" Foreground="#F0F0F0"/>
                    <TextBlock x:Name="AboutSubtitleText" FontSize="14" Foreground="#888888"/>
                  </StackPanel>
                </StackPanel>

                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock x:Name="LabelVersion" Classes="row-label"/>
                  <TextBlock x:Name="VersionText" Grid.Column="1" Classes="row-value" Text="1.0.0"/>
                </Grid>
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock x:Name="LabelAuthor" Classes="row-label"/>
                  <TextBlock Grid.Column="1" Text="Lenkmat" Classes="row-value" Foreground="#F0F0F0"/>
                </Grid>

                <Grid ColumnDefinitions="*,Auto">
                  <Button x:Name="CheckUpdateBtn" Grid.Column="1"
                          Width="140" Height="36"
                          Background="#2A2A2D" Foreground="#E0E0E0"
                          BorderThickness="1" BorderBrush="#3A3A3C"
                          CornerRadius="8" FontSize="14" Cursor="Hand"
                          HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
                </Grid>
                <TextBlock x:Name="UpdateStatusText" Classes="row-desc" HorizontalAlignment="Right"/>
              </StackPanel>
            </StackPanel>

            <!-- 字体安装 -->
            <StackPanel>
              <TextBlock x:Name="FontSectionTitle" Classes="section-title"/>
              <Border Classes="section-bar"/>
              <TextBlock x:Name="FontDescText" Classes="row-desc" Margin="0,12,0,0"/>
              <Grid ColumnDefinitions="*,Auto" Margin="0,12,0,0">
                <Button x:Name="FontInstallBtn" Grid.Column="1"
                        Width="140" Height="36"
                        Background="#2A2A2D" Foreground="#E0E0E0"
                        BorderThickness="1" BorderBrush="#3A3A3C"
                        CornerRadius="8" FontSize="14" Cursor="Hand"
                        HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
              </Grid>
              <TextBlock x:Name="FontStatusText" Classes="row-desc" HorizontalAlignment="Right" Margin="0,8,0,0"/>
            </StackPanel>
          </StackPanel>
        </StackPanel>
      </ScrollViewer>

      <!-- ================= 底部动作行：左「保存」 / 右「收起」（仅这两个控件） ================= -->
      <Grid Grid.Row="3" Height="40" Margin="28,0,28,28" ColumnDefinitions="Auto,*,Auto">
        <Button x:Name="SaveBtn" Classes="round-action save-action">
          <Path Width="20" Height="20" Stretch="Uniform"
                Data="{DynamicResource Icon.Save}" Fill="#1A1A1C"/>
        </Button>
        <TextBlock x:Name="SavedHint" Grid.Column="1" Margin="12,0,0,0"
                   FontSize="14" Foreground="#C6CA4C" VerticalAlignment="Center" Opacity="0"/>
        <Button x:Name="CollapseBtn" Grid.Column="2" Classes="round-action collapse-action">
          <Path Width="20" Height="20" Stretch="Uniform"
                Data="{DynamicResource Icon.ChevronUp}" Fill="#E8E8E8"/>
        </Button>
      </Grid>
    </Grid>
    </Border>
  </Grid>
</Window>
